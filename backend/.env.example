# Flask配置
FLASK_APP=run.py
FLASK_CONFIG=development
FLASK_DEBUG=True

# 数据库配置
DEV_DATABASE_URL=mysql+pymysql://root:password@localhost/bom_dev
TEST_DATABASE_URL=mysql+pymysql://root:password@localhost/bom_test
DATABASE_URL=mysql+pymysql://root:password@localhost/bom_prod
VISIRAY_DATABASE_URL=mysql+pymysql://root:password@localhost/visiray

# 安全密钥
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-string-change-in-production

# Redis配置
# REDIS_URL=redis://localhost:6379/0

# SSO配置（可选）
SSO_ENABLED=false
SAML_ENTITY_ID=http://localhost:5000
SAML_SSO_URL=
SAML_CERT_PATH=

# OAuth2.0配置（可选）
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZATION_URL=
OAUTH_TOKEN_URL=
OAUTH_USER_INFO_URL=
